# ---- Source APIs (cloud mode) ----
MARKETING_API_URL=https://api.example-marketing.com
MARKETING_API_TOKEN=
CRM_API_URL=https://api.example-crm.com
CRM_API_TOKEN=

# ---- S3 landing zone (cloud mode) ----
S3_BUCKET=my-marketing-data-lake
S3_PREFIX=marketing-raw
AWS_REGION=us-east-1
# AWS credentials come from the standard AWS chain (env vars, profile, or IAM role)

# ---- Snowflake (cloud mode + dbt snowflake target) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=MARKETING_WH
SNOWFLAKE_DATABASE=MARKETING

# ---- dbt ----
# duckdb (default, local demo) or snowflake
DBT_TARGET=duckdb
